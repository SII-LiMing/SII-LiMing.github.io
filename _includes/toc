<aside class="sidebar__right{% if include.class %} {{ include.class }}{% endif %}">
<nav class="toc" aria-label="On this page"{% unless include.items %} markdown="1"{% endunless %}>
{% unless include.hide_title %}
<header><h4 class="nav__title"><i class="fa fa-{{ include.icon | default: 'file-text' }}"></i> {{ include.title | default: site.data.ui-text[site.locale].toc_label }}</h4></header>
{% endunless %}
{% if include.items %}
<ul class="toc__menu">
  {% for item in include.items %}
    <li><a href="{{ item.url }}">{{ item.title }}</a></li>
  {% endfor %}
</ul>
{% else %}
*  Auto generated table of contents
{:toc .toc__menu}
{% endif %}
</nav>
</aside>
